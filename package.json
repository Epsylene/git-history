{
  "name": "git-history",
  "displayName": "Git History",
  "description": "File History, Line History, Stashes and Branch Changes views in the Source Control sidebar.",
  "version": "0.4.0",
  "publisher": "epsylene",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "files": [
    "*.js",
    "LICENSE",
    "README.md"
  ],
  "activationEvents": [],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Git History",
      "properties": {
        "gitHistory.maxCommits": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Number of commits to load at once in the history views."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "gitHistory.fileHistory",
          "name": "File History"
        },
        {
          "id": "gitHistory.lineHistory",
          "name": "Line History"
        },
        {
          "id": "gitHistory.stashes",
          "name": "Stashes"
        },
        {
          "id": "gitHistory.branch",
          "name": "Branch Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "gitHistory.refresh",
        "title": "Refresh",
        "category": "Git History",
        "icon": "$(refresh)"
      },
      {
        "command": "gitHistory.loadMore",
        "title": "Load More",
        "category": "Git History"
      },
      {
        "command": "gitHistory.openChanges",
        "title": "Open Changes",
        "category": "Git History",
        "icon": "$(diff)"
      },
      {
        "command": "gitHistory.openRevision",
        "title": "Open File at Revision",
        "category": "Git History",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitHistory.compareWithWorking",
        "title": "Compare with Working File",
        "category": "Git History"
      },
      {
        "command": "gitHistory.copyHash",
        "title": "Copy Commit Hash",
        "category": "Git History"
      },
      {
        "command": "gitHistory.copyMessage",
        "title": "Copy Commit Message",
        "category": "Git History"
      },
      {
        "command": "gitHistory.stashChanges",
        "title": "Stash Changes",
        "category": "Git History",
        "icon": "$(add)"
      },
      {
        "command": "gitHistory.stashChangesUntracked",
        "title": "Stash Changes (Include Untracked)",
        "category": "Git History"
      },
      {
        "command": "gitHistory.refreshStashes",
        "title": "Refresh",
        "category": "Git History",
        "icon": "$(refresh)"
      },
      {
        "command": "gitHistory.applyStash",
        "title": "Apply Stash",
        "category": "Git History",
        "icon": "$(check)"
      },
      {
        "command": "gitHistory.popStash",
        "title": "Pop Stash",
        "category": "Git History",
        "icon": "$(export)"
      },
      {
        "command": "gitHistory.dropStash",
        "title": "Drop Stash",
        "category": "Git History",
        "icon": "$(trash)"
      },
      {
        "command": "gitHistory.openStashChanges",
        "title": "Open All Changes",
        "category": "Git History",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitHistory.changeBase",
        "title": "Change Base Branch…",
        "category": "Git History",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitHistory.refreshBranch",
        "title": "Refresh",
        "category": "Git History",
        "icon": "$(refresh)"
      },
      {
        "command": "gitHistory.openBranchChanges",
        "title": "Open All Changes",
        "category": "Git History",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitHistory.openCommitChanges",
        "title": "Open All Changes",
        "category": "Git History",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitHistory.compareWithRef",
        "title": "Compare File with Branch or Tag…",
        "category": "Git History",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitHistory.loadMore",
          "when": "false"
        },
        {
          "command": "gitHistory.openChanges",
          "when": "false"
        },
        {
          "command": "gitHistory.openRevision",
          "when": "false"
        },
        {
          "command": "gitHistory.compareWithWorking",
          "when": "false"
        },
        {
          "command": "gitHistory.copyHash",
          "when": "false"
        },
        {
          "command": "gitHistory.copyMessage",
          "when": "false"
        },
        {
          "command": "gitHistory.refreshStashes",
          "when": "false"
        },
        {
          "command": "gitHistory.applyStash",
          "when": "false"
        },
        {
          "command": "gitHistory.popStash",
          "when": "false"
        },
        {
          "command": "gitHistory.dropStash",
          "when": "false"
        },
        {
          "command": "gitHistory.openStashChanges",
          "when": "false"
        },
        {
          "command": "gitHistory.refreshBranch",
          "when": "false"
        },
        {
          "command": "gitHistory.openCommitChanges",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitHistory.compareWithRef",
          "when": "view == gitHistory.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "gitHistory.refresh",
          "when": "view == gitHistory.fileHistory || view == gitHistory.lineHistory",
          "group": "navigation"
        },
        {
          "command": "gitHistory.stashChanges",
          "when": "view == gitHistory.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitHistory.refreshStashes",
          "when": "view == gitHistory.stashes",
          "group": "navigation@2"
        },
        {
          "command": "gitHistory.stashChangesUntracked",
          "when": "view == gitHistory.stashes",
          "group": "1_stash"
        },
        {
          "command": "gitHistory.openBranchChanges",
          "when": "view == gitHistory.branch",
          "group": "navigation@1"
        },
        {
          "command": "gitHistory.changeBase",
          "when": "view == gitHistory.branch",
          "group": "navigation@2"
        },
        {
          "command": "gitHistory.refreshBranch",
          "when": "view == gitHistory.branch",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitHistory.openRevision",
          "when": "view =~ /^gitHistory\\./ && viewItem == commit",
          "group": "inline"
        },
        {
          "command": "gitHistory.openChanges",
          "when": "view =~ /^gitHistory\\./ && viewItem =~ /^(commit|uncommitted)$/",
          "group": "1_open@1"
        },
        {
          "command": "gitHistory.openRevision",
          "when": "view =~ /^gitHistory\\./ && viewItem == commit",
          "group": "1_open@2"
        },
        {
          "command": "gitHistory.compareWithWorking",
          "when": "view =~ /^gitHistory\\./ && viewItem == commit",
          "group": "1_open@3"
        },
        {
          "command": "gitHistory.copyHash",
          "when": "view =~ /^gitHistory\\./ && viewItem == commit",
          "group": "2_copy@1"
        },
        {
          "command": "gitHistory.copyMessage",
          "when": "view =~ /^gitHistory\\./ && viewItem == commit",
          "group": "2_copy@2"
        },
        {
          "command": "gitHistory.openStashChanges",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "gitHistory.applyStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "gitHistory.popStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "inline@3"
        },
        {
          "command": "gitHistory.dropStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "inline@4"
        },
        {
          "command": "gitHistory.openStashChanges",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "1_open@1"
        },
        {
          "command": "gitHistory.applyStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "2_stash@1"
        },
        {
          "command": "gitHistory.popStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "2_stash@2"
        },
        {
          "command": "gitHistory.dropStash",
          "when": "view == gitHistory.stashes && viewItem == stash",
          "group": "3_drop@1"
        },
        {
          "command": "gitHistory.stashChanges",
          "when": "view == gitHistory.stashes && viewItem == repository",
          "group": "inline"
        },
        {
          "command": "gitHistory.stashChanges",
          "when": "view == gitHistory.stashes && viewItem == repository",
          "group": "1_stash@1"
        },
        {
          "command": "gitHistory.stashChangesUntracked",
          "when": "view == gitHistory.stashes && viewItem == repository",
          "group": "1_stash@2"
        },
        {
          "command": "gitHistory.openBranchChanges",
          "when": "view == gitHistory.branch && viewItem == branchRepo",
          "group": "inline@1"
        },
        {
          "command": "gitHistory.changeBase",
          "when": "view == gitHistory.branch && viewItem == branchRepo",
          "group": "inline@2"
        },
        {
          "command": "gitHistory.openBranchChanges",
          "when": "view == gitHistory.branch && viewItem == branchFiles",
          "group": "inline"
        },
        {
          "command": "gitHistory.openCommitChanges",
          "when": "view == gitHistory.branch && viewItem == branchCommit",
          "group": "inline"
        },
        {
          "command": "gitHistory.openCommitChanges",
          "when": "view == gitHistory.branch && viewItem == branchCommit",
          "group": "1_open@1"
        },
        {
          "command": "gitHistory.copyHash",
          "when": "view == gitHistory.branch && viewItem == branchCommit",
          "group": "2_copy@1"
        },
        {
          "command": "gitHistory.copyMessage",
          "when": "view == gitHistory.branch && viewItem == branchCommit",
          "group": "2_copy@2"
        }
      ]
    }
  }
}
